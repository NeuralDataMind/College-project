# 2. Node.js & Backend Gateway
# --------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Uploads directory (preserve folder, ignore user uploads)
backend/uploads/*
!backend/uploads/.gitkeep

